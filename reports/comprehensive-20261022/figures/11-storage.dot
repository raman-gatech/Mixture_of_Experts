label="Storage roles and preservation";labelloc=t;
h [label="NFS home\nsmall settings, credentials, OnDemand databases",fillcolor="#eff6ff"];
s [label="Persistent scratch\nenvironments, data, checkpoints, archives, logs, caches",fillcolor="#eff6ff"];
