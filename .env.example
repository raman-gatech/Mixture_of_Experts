# Artifact root must contain base/, router/, math_expert/, science_expert/, general_expert/.
MOE_MODEL_ROOT=./artifacts
MOE_ROUTER_DIR=./artifacts/router-earlier
MOE_BASE_DIR=./artifacts/base
MOE_HOST=127.0.0.1
MOE_PORT=8510
# Set for authenticated access when exposing beyond an SSH tunnel.
MOE_API_TOKEN=
MOE_ROUTER_DEVICE=cpu
MOE_MAX_INPUT_TOKENS=1024
MOE_MAX_NEW_TOKENS=200
MOE_QUEUE_CAPACITY=4
MOE_QUEUE_TIMEOUT=20
MOE_GENERATION_TIMEOUT=60
